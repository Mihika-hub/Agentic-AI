{
  "name": "pulsefit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/dev-server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "node scripts/db-setup.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "lighthouse": "vite build && node scripts/lighthouse.js latest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.17",
    "jose": "^6.2.12",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "lighthouse": "^13.5.0",
    "postcss": "^8.4.49",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
